generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// Better Auth 认证表
// ──────────────────────────────────────────────

model user {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  username      String?  @unique
  displayUsername String?
  emailVerified Boolean  @default(false)
  image         String?
  role          String   @default("user")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions session[]
  accounts account[]
  posts    post[]
  postOperationLogs postOperationLog[]
}

model session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ──────────────────────────────────────────────
// 业务表
// ──────────────────────────────────────────────

model post {
  id                  String    @id @default(uuid())
  title               String
  slug                String    @unique
  excerpt             String?   @db.Text
  coverImageUrl       String?   @db.Text
  contentJson         Json
  contentHtml         String    @db.Text
  contentText         String    @db.Text
  /// contentText 的有界前缀，供列表卡片和 RSS 摘要使用。
  /// 让公开列表不必为了 120 字预览把整篇正文拉出来。
  previewText         String?
  contentToc          Json
  /// 技术值仅使用 draft（内部）和 published（已发布）
  status              String    @default("draft")
  publishedAt         DateTime?
  readingTimeMinutes  Int?
  wordCount           Int?
  seoTitle            String?
  seoDescription      String?   @db.Text
  canonicalUrl        String?   @db.Text
  isFeatured          Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  categoryId String?
  category   category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  folderId String?
  folder   folder? @relation(fields: [folderId], references: [id], onDelete: Restrict)

  createdBy String
  author    user   @relation(fields: [createdBy], references: [id])

  tags postTag[]
  mediaReferences postMediaReference[]
  operationLogs postOperationLog[]

  @@index([categoryId])
  @@index([folderId])
  @@index([createdBy])
  @@index([status])
  @@index([publishedAt])
  @@index([status, updatedAt, createdAt])
  @@index([status, publishedAt, createdAt])
  @@index([status, categoryId, publishedAt])
  @@index([status, folderId, updatedAt])
  /// 公开列表的排序是 isFeatured DESC, publishedAt DESC, createdAt DESC，
  /// 缺少包含 isFeatured 的索引时 Postgres 只能每次重排全部已发布行。
  @@index([status, isFeatured, publishedAt, createdAt])
}

model folder {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts post[]
}

model category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts post[]
}

model tag {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts postTag[]
}

model postTag {
  postId String
  tagId  String

  post post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

model siteSetting {
  id              String   @id @default(uuid())
  scopeKey        String   @unique @default("default")
  siteTitle       String
  siteSubtitle    String?
  siteDescription String?  @db.Text
  siteUrl         String
  logoUrl         String?  @db.Text
  faviconUrl      String?  @db.Text
  avatarUrl       String?  @db.Text
  githubUrl       String?  @db.Text
  xUrl            String?  @db.Text
  email           String?
  footerText      String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model aiSetting {
  id                String   @id @default(uuid())
  scopeKey          String   @unique @default("default")
  aiConfigured      Boolean  @default(false)
  aiProvider        String   @default("openai-compatible")
  aiBaseUrl         String?  @db.Text
  aiModel           String?
  aiApiKeyEncrypted String?  @db.Text
  aiProtocol        String   @default("chat-completions")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model media {
  id              String   @id @default(uuid())
  url             String   @db.Text
  storageProvider String   @default("local")
  storageKey      String?  @db.Text
  filename        String
  mimeType        String
  size            Int
  width           Int?
  height          Int?
  alt             String?  @db.Text
  createdAt       DateTime @default(now())

  postReferences  postMediaReference[]

  @@index([mimeType])
  @@index([createdAt])
  @@index([storageProvider])
  @@index([storageProvider, storageKey])
  /// 封面图按 url 批量回查媒体元数据（url IN (...)），缺索引会全表扫描。
  @@index([url])
}

model postMediaReference {
  postId String
  mediaId String
  usage String

  post post @relation(fields: [postId], references: [id], onDelete: Cascade)
  media media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([postId, mediaId, usage])
  @@index([postId])
  @@index([mediaId, usage])
}

model postOperationLog {
  id          String   @id @default(uuid())
  operation   String
  summary     String
  detail      Json
  createdAt   DateTime @default(now())

  postId      String?
  post        post?    @relation(fields: [postId], references: [id], onDelete: SetNull)

  createdBy   String
  author      user     @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([createdBy, createdAt])
  @@index([postId, createdAt])
}
