{
  "name": "blog-01",
  "version": "0.1.0",
  "description": "Self-hosted Next.js blog system with PostgreSQL, Prisma, Better Auth and Tiptap.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/duobaobox/blog-01.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "tsx --tsconfig tsconfig.test.json --test && npm run test:backup",
    "test:backup": "sh scripts/backup-docker.test.sh",
    "lint": "eslint",
    "format": "npx --yes prettier@3.9.6 --write .",
    "format:check": "npx --yes prettier@3.9.6 --check .",
    "db:sync": "sh scripts/schema-sync.sh",
    "db:push": "prisma db push",
    "db:diff": "sh scripts/check-schema-diff.sh",
    "db:baseline": "tsx scripts/baseline-migration.ts",
    "db:rehearse:baseline": "tsx scripts/rehearse-migration-baseline.ts",
    "db:check:migrations": "tsx scripts/check-migration-state.ts",
    "db:check:migration-coverage": "tsx scripts/check-migration-coverage.ts",
    "db:check:sync-mode": "node scripts/resolve-schema-sync-mode.mjs --details",
    "db:check:site-settings": "tsx scripts/check-site-settings-singleton.ts",
    "db:preflight:release": "tsx scripts/preflight-release-db.ts",
    "db:backfill:post-media-references": "tsx scripts/backfill-post-media-references.ts",
    "db:backfill:post-content": "tsx scripts/backfill-post-content.ts",
    "db:explain:posts": "tsx scripts/explain-post-queries.ts",
    "db:explain:posts:analyze": "tsx scripts/explain-post-queries.ts --analyze",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo-posts": "tsx prisma/seed-demo-posts.ts",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@floating-ui/react": "^0.27.20",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/postprocessing": "^3.0.4",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-popover": "^1.1.19",
    "@tiptap/core": "^3.28.0",
    "@tiptap/extension-highlight": "^3.28.0",
    "@tiptap/extension-horizontal-rule": "^3.28.0",
    "@tiptap/extension-image": "^3.28.0",
    "@tiptap/extension-link": "^3.28.0",
    "@tiptap/extension-list": "^3.28.0",
    "@tiptap/extension-placeholder": "^3.28.0",
    "@tiptap/extension-subscript": "^3.28.0",
    "@tiptap/extension-superscript": "^3.28.0",
    "@tiptap/extension-table": "^3.28.0",
    "@tiptap/extension-text-align": "^3.28.0",
    "@tiptap/extension-typography": "^3.28.0",
    "@tiptap/extensions": "^3.28.0",
    "@tiptap/html": "^3.20.4",
    "@tiptap/markdown": "^3.28.0",
    "@tiptap/pm": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "@types/three": "^0.183.1",
    "@vercel/blob": "^2.3.1",
    "better-auth": "^1.5.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "lodash.throttle": "^4.1.1",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "pinyin-pro": "^3.28.0",
    "prisma": "^7.5.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hotkeys-hook": "^5.3.3",
    "reading-time": "^1.5.0",
    "rehype-parse": "^9.0.1",
    "rehype-pretty-code": "^0.14.3",
    "rehype-stringify": "^10.0.1",
    "shadcn": "^4.0.6",
    "shiki": "^4.0.2",
    "slugify": "^1.6.6",
    "tailwind-merge": "^3.5.0",
    "sass": "^1.101.0",
    "three": "^0.183.2",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/lodash.throttle": "^4.1.9",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/pg": "^8.18.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
