# 数据库连接
DATABASE_URL="postgresql://user:password@localhost:5432/blog?schema=public"

# Docker Compose 内置数据库时使用
POSTGRES_USER="blog"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="blog"
POSTGRES_PORT="5432"
APP_PORT="3000"

# Better Auth
BETTER_AUTH_SECRET="your-secret-key-here"
BETTER_AUTH_URL="http://localhost:3000"
# 高级：如需保留手动初始化能力可设置；默认首启会自动准备管理员账号
ADMIN_SETUP_TOKEN=""

# 站点 URL（用于 sitemap、canonical 等，服务端运行时读取，无需重新构建镜像）
SITE_URL="http://localhost:3000"

# 默认管理员账号（首次启动可直接登录，登录后请尽快修改账号和密码）
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="admin123456"

# 高级：默认无需修改。只有接入云对象存储时才需要启用。
# STORAGE_PROVIDER="vercel-blob"
# BLOB_READ_WRITE_TOKEN=""
