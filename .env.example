# 数据库连接
DATABASE_URL="postgresql://user:password@localhost:5432/blog?schema=public"

# Docker Compose 内置数据库时使用
POSTGRES_USER="blog"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="blog"
POSTGRES_PORT="5432"
APP_PORT="3000"

# Better Auth
BETTER_AUTH_SECRET="your-secret-key-here"
BETTER_AUTH_URL="http://localhost:3000"

# 开发环境固定测试管理员
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="admin123456"

# 首次初始化管理员时使用；生产环境建议配置强随机值
ADMIN_SETUP_TOKEN=""

# 站点 URL（用于 sitemap、canonical 等）
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 媒体存储：local | vercel-blob
STORAGE_PROVIDER="local"

# 当 STORAGE_PROVIDER=vercel-blob 时必填
BLOB_READ_WRITE_TOKEN=""
