# 数据库连接
DATABASE_URL="postgresql://user:password@localhost:5432/blog?schema=public"

# Docker Compose 内置数据库时使用
POSTGRES_USER="blog"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="blog"
POSTGRES_PORT="5432"
APP_PORT="3000"

# Better Auth
BETTER_AUTH_SECRET="your-secret-key-here"
BETTER_AUTH_URL="http://localhost:3000"

# 站点 URL（用于 sitemap、canonical 等，服务端运行时读取，无需重新构建镜像）
SITE_URL="http://localhost:3000"

# 媒体存储：local | vercel-blob
STORAGE_PROVIDER="local"

# 当 STORAGE_PROVIDER=vercel-blob 时必填
BLOB_READ_WRITE_TOKEN=""

# 开发环境测试管理员（仅 NODE_ENV=development 时生效）
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="admin123456"
