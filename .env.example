# 数据库连接
DATABASE_URL="postgresql://user:password@localhost:5432/blog?schema=public"

# Docker Compose 内置数据库时使用
POSTGRES_USER="blog"
POSTGRES_PASSWORD="replace-with-a-strong-password"
POSTGRES_DB="blog"
APP_PORT="3000"

# Better Auth
BETTER_AUTH_SECRET="your-secret-key-here"
BETTER_AUTH_URL="http://localhost:3000"
# 生产初始化口令。设置后首次初始化会通过 /admin/setup 表单创建自定义管理员。
ADMIN_SETUP_TOKEN="replace-with-a-one-time-setup-token"

# 站点 URL（用于 sitemap、canonical 等，服务端运行时读取，无需重新构建镜像）
SITE_URL="http://localhost:3000"

# 本地开发默认管理员账号（仅在非生产且未设置 ADMIN_SETUP_TOKEN 时自动创建）
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="admin123456"

# 高级：默认无需修改。只有接入云对象存储时才需要启用。
# STORAGE_PROVIDER="vercel-blob"
# BLOB_READ_WRITE_TOKEN=""

# BYOK AI（可选；后台未保存配置时使用，只在服务端读取，不要提交真实密钥）
# AI_ENABLED="false"
# AI_PROVIDER="openai-compatible"
# AI_BASE_URL="https://api.openai.com/v1"
# AI_API_KEY=""
# AI_MODEL=""
# AI_PROTOCOL="chat-completions"
# AI_TIMEOUT_MS="30000"
# AI_MAX_INPUT_CHARS="30000"
